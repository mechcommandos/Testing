{
  "appId": "com.layjou.battle",
  "appName": "Layjou Battle",
  "webDir": "dist",
  "backgroundColor": "#0b1440",
  "android": {
    "backgroundColor": "#0b1440",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#0b1440",
    "contentInset": "never",
    "scrollEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 900,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#0b1440",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_layjou",
      "iconColor": "#1cc3d2"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
