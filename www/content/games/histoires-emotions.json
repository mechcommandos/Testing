        {
            "id": "tour",
            "who": "Léo",
            "text": "Léo est en colère : son petit frère a fait tomber sa tour.",
            "question": "Que pourrait faire Léo ?",
            "options": [
                {
                    "id": "dire",
                    "text": "Respirer doucement, puis dire : « Je suis fâché, tu as cassé ma tour. »",
                    "consequence": "Son frère comprend que Léo est fâché. Ils reconstruisent la tour ensemble."
                },
                {
                    "id": "pousser",
                    "text": "Crier très fort et pousser son frère.",
                    "consequence": "Son frère tombe et pleure. Léo est toujours en colère, et maintenant triste aussi."
                },
                {
                    "id": "adulte",
                    "text": "Aller chercher un adulte.",
                    "consequence": "L’adulte écoute les deux frères et les aide à trouver une solution."
                }
            ]
        },
