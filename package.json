{
  "name": "layjou-blocks",
  "version": "1.0.0",
  "private": true,
  "description": "LayJou Blocks — puzzle de blocs avec LayJou le robot (Capacitor, Android & iOS)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:sandbox": "tsc --noEmit && vite build --mode sandbox",
    "preview": "vite preview",
    "test": "vitest run",
    "assets": "python3 scripts/build_assets.py",
    "sync": "npm run build && cap sync",
    "android:debug": "npm run build:sandbox && cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build && cap sync android && cd android && ./gradlew bundleRelease",
    "ios:sync": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/native-purchases": "^8.9.13",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
