{
  "name": "layjou-bubble",
  "version": "1.0.0",
  "description": "LayJou Bubble — jeu de match-3 avec le robot LayJou (Capacitor + AdMob)",
  "private": true,
  "scripts": {
    "start": "npx serve www",
    "test": "node tests/engine.test.mjs",
    "sync": "cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#E6F4FB' --iconBackgroundColorDark '#0B3A8F' --splashBackgroundColor '#E6F4FB' --splashBackgroundColorDark '#E6F4FB'",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "ios:open": "cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  },
  "type": "module"
}